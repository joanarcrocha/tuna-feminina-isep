# Configuração de produção (docker compose). Copie para .env no servidor.

# Domínio do site, sem https:// nem www
DOMAIN=tufeisep.pt

# Palavra-passe partilhada para editar o arquivo. Use uma longa e diferente da de testes.
ADMIN_PASSWORD=

# Site "em construção": enquanto estiver preenchida, os visitantes só veem a página de bloqueio
# e têm de introduzir esta palavra-passe. Para abrir o site ao público, deixe-a vazia e corra `docker compose up -d`.
SITE_PASSWORD=
