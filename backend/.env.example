# Porta da API
PORT=3001

# Palavra-passe partilhada para editar o arquivo
ADMIN_PASSWORD=muda-esta-palavra-passe

# Site "em construção": se estiver preenchida, o site fica bloqueado até se introduzir esta palavra-passe.
# Deixe vazia para o site ficar aberto.
SITE_PASSWORD=

# Pasta onde ficam a base de dados e as fotografias (relativa a backend/)
DATA_DIR=data

# Pasta das cópias de segurança diárias. De preferência noutro disco ou numa pasta
# sincronizada com a nuvem (OneDrive, Google Drive). Por omissão: data/backups
# BACKUP_DIR=D:/Backups/tuna-feminina-isep
